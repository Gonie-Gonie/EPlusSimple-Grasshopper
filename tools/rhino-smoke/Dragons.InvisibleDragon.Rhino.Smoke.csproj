<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>Dragons.InvisibleDragon.Rhino.Smoke</AssemblyName>
    <RootNamespace>Dragons.InvisibleDragon.RhinoSmoke</RootNamespace>
    <Description>STA-hosted Rhino 8 smoke checks for the InvisibleDragon geometry adapter.</Description>
    <NoWarn>$(NoWarn);NU1701;CA1031;CA1510;CA1512</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\InvisibleDragon\Dragons.InvisibleDragon.Rhino\Dragons.InvisibleDragon.Rhino.csproj" />
    <PackageReference Include="Rhino.Inside" />
    <PackageReference Include="RhinoCommon" VersionOverride="8.0.23304.9001" Private="false" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
