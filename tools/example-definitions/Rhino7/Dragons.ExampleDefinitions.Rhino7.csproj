<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>Dragons.ExampleDefinitions.Rhino7</AssemblyName>
    <RootNamespace>Dragons.ExampleDefinitions.Rhino7</RootNamespace>
    <Description>Real Rhino 7 generator and reopen validator for tracked Dragon Grasshopper examples.</Description>
    <NoWarn>$(NoWarn);NU1608;CA1031;CA1510;CA1512</NoWarn>
    <Rhino7SystemDir Condition="'$(Rhino7SystemDir)' == ''">C:\Program Files\Rhino 7\System</Rhino7SystemDir>
    <Rhino7GrasshopperDir Condition="'$(Rhino7GrasshopperDir)' == ''">C:\Program Files\Rhino 7\Plug-ins\Grasshopper</Rhino7GrasshopperDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Rhino.Inside" VersionOverride="7.0.0" />
    <PackageReference Include="RhinoCommon" VersionOverride="7.0.20314.3001" ExcludeAssets="all" />
    <PackageReference Include="Grasshopper" VersionOverride="7.0.20314.3001" ExcludeAssets="all" />
    <PackageReference Include="RhinoWindows" VersionOverride="7.0.20314.3001" ExcludeAssets="all" />
    <Reference Include="RhinoCommon">
      <HintPath>$(Rhino7SystemDir)\RhinoCommon.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Grasshopper">
      <HintPath>$(Rhino7GrasshopperDir)\Grasshopper.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GH_IO">
      <HintPath>$(Rhino7GrasshopperDir)\GH_IO.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\CanonicalExamplePublisher.cs" Link="Shared\CanonicalExamplePublisher.cs" />
    <Compile Include="..\Shared\AdvancedExampleDefinitions.cs" Link="Shared\AdvancedExampleDefinitions.cs" />
    <Compile Include="..\Shared\ExampleBuildingModels.cs" Link="Shared\ExampleBuildingModels.cs" />
    <Compile Include="..\Shared\ExampleDefinitionGate.cs" Link="Shared\ExampleDefinitionGate.cs" />
    <Compile Include="..\Shared\ExampleHostInputs.cs" Link="Shared\ExampleHostInputs.cs" />
    <Compile Include="..\Shared\IsExternalInit.cs" Link="Shared\IsExternalInit.cs" />
  </ItemGroup>
</Project>
