* text=auto
.gitattributes text eol=lf
.editorconfig text eol=lf

*.cs text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.ps1 text eol=lf
*.cmd text eol=crlf
# The hybrid release installer is hashed into a deterministic ZIP; keep its
# tested LF bytes identical on every checkout (cmd.exe accepts LF scripts).
packaging/release/Install-Dragons.cmd text eol=lf
*.sln text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.csv text eol=lf
*.py text eol=lf
*.txt text eol=lf
*.idf text eol=lf

# Preserve byte-for-byte upstream oracle payloads so their pinned SHA-256 values survive checkout.
data/simple-dragon/** binary
fixtures/simple-dragon/** binary
# Compatibility manifests pin these editable JSON model bytes; force LF on every host.
fixtures/compatibility/models/*.grm text eol=lf

*.gh binary
*.ghx text eol=lf
*.3dm binary
*.png binary
*.jpg binary
*.jpeg binary
*.gz binary
