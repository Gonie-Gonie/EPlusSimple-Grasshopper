<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net7.0-windows;net8.0-windows</TargetFrameworks>
    <AssemblyName>Dragons.InvisibleDragon.GH</AssemblyName>
    <RootNamespace>Dragons.InvisibleDragon.Grasshopper</RootNamespace>
    <Description>InvisibleDragon components for Rhino 7 and Rhino 8 Grasshopper.</Description>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <TargetExt>.gha</TargetExt>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dragons.InvisibleDragon.Core\Dragons.InvisibleDragon.Core.csproj" />
    <ProjectReference Include="..\Dragons.InvisibleDragon.Rhino\Dragons.InvisibleDragon.Rhino.csproj" />
    <ProjectReference Include="..\Dragons.InvisibleDragon.Grasshopper.Types\Dragons.InvisibleDragon.Grasshopper.Types.csproj" />
    <PackageReference Include="Grasshopper" VersionOverride="7.0.20314.3001" ExcludeAssets="runtime" Condition="'$(TargetFramework)' == 'net48'" />
    <PackageReference Include="Grasshopper" VersionOverride="8.0.23304.9001" ExcludeAssets="runtime" Condition="'$(TargetFramework)' != 'net48'" />
    <PackageReference Include="RhinoCommon" VersionOverride="7.0.20314.3001" ExcludeAssets="runtime" Condition="'$(TargetFramework)' == 'net48'" />
    <PackageReference Include="RhinoCommon" VersionOverride="8.0.23304.9001" ExcludeAssets="runtime" Condition="'$(TargetFramework)' != 'net48'" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\..\resources\icons\generated\invisible-dragon\invisible-dragon-24.png"
                      Link="Resources\invisible-dragon-24.png"
                      LogicalName="Dragons.InvisibleDragon.Grasshopper.Resources.InvisibleDragon24.png" />
    <EmbeddedResource Include="..\..\..\resources\icons\generated\invisible-dragon\components\*.png">
      <Link>Resources\Components\%(Filename)%(Extension)</Link>
      <LogicalName>Dragons.InvisibleDragon.Grasshopper.Resources.Components.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
