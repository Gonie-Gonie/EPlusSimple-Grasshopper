<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net7.0-windows;net8.0-windows</TargetFrameworks>
    <AssemblyName>Dragons.InvisibleDragon.Rhino</AssemblyName>
    <RootNamespace>Dragons.InvisibleDragon.Rhino</RootNamespace>
    <Description>Rhino geometry adapters for InvisibleDragon.Core.</Description>
    <!-- CA1510/CA1512 suggest guard APIs that do not exist on the Rhino 7 net48 target. -->
    <NoWarn>$(NoWarn);NU1701;CA1510;CA1512</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dragons.InvisibleDragon.Core\Dragons.InvisibleDragon.Core.csproj" />
    <PackageReference Include="RhinoCommon" VersionOverride="7.0.20314.3001" ExcludeAssets="runtime" Condition="'$(TargetFramework)' == 'net48'" />
    <PackageReference Include="RhinoCommon" VersionOverride="8.0.23304.9001" ExcludeAssets="runtime" Condition="'$(TargetFramework)' != 'net48'" />
  </ItemGroup>
</Project>
