<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net7.0-windows;net8.0-windows</TargetFrameworks>
    <AssemblyName>GonieGonie.SimpleDragon.Rhino</AssemblyName>
    <RootNamespace>GonieGonie.SimpleDragon.Rhino</RootNamespace>
    <Description>Rhino geometry extraction adapters for SimpleDragon.Core.</Description>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GonieGonie.SimpleDragon.Core\GonieGonie.SimpleDragon.Core.csproj" />
    <ProjectReference Include="..\..\InvisibleDragon\GonieGonie.InvisibleDragon.Rhino\GonieGonie.InvisibleDragon.Rhino.csproj" />
    <PackageReference Include="RhinoCommon" VersionOverride="7.0.20314.3001" ExcludeAssets="runtime" Condition="'$(TargetFramework)' == 'net48'" />
    <PackageReference Include="RhinoCommon" VersionOverride="8.0.23304.9001" ExcludeAssets="runtime" Condition="'$(TargetFramework)' != 'net48'" />
  </ItemGroup>
</Project>
